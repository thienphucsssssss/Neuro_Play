{
  "name": "game-tri-tue-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --test",
    "test:auth": "node --env-file-if-exists=.env.auth-test --test integration/auth.mjs",
    "db:check": "node --env-file-if-exists=.env src/check-db.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.4",
    "typescript": "~6.0"
  }
}
